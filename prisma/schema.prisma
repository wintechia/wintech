generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Lead {
  id            String    @id @default(cuid())
  nombre        String
  email         String
  telefono      String?
  empresa       String?
  nicho         String?
  planInteres   String?
  mensaje       String?
  fuente        String    @default("contacto")
  estado        String    @default("nuevo")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@index([nicho])
  @@index([estado])
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  coverImage    String?
  author        String    @default("WinTech AI")
  category      String    @default("IA")
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([published])
}

model ChatMessage {
  id            String    @id @default(cuid())
  sessionId     String
  role          String
  content       String
  nicho         String?
  createdAt     DateTime  @default(now())

  @@index([sessionId])
}

model Reserva {
  id            String    @id @default(cuid())
  nombre        String
  email         String
  telefono      String?
  empresa       String?
  nicho         String
  servicio      String
  fecha         DateTime
  hora          String
  estado        String    @default("pendiente")
  notas         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([fecha])
  @@index([nicho])
  @@index([estado])
}
