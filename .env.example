# WinTech AI Agency - Environment Variables
# Copy this file to .env and fill in your values

# Database (Supabase)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# OpenRouter (free models for zero-cost inference)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Abacus AI (legacy)
ABACUSAI_API_KEY=s2_your_key_here
WEB_APP_ID=your_web_app_id

# Notification IDs
NOTIF_ID_FORMULARIO_DE_CONTACTO=your_notif_id
NOTIF_ID_SOLICITUD_DEMO=your_notif_id

# Site URL
NEXT_PUBLIC_SITE_URL=https://wintech.agency
